{
  "name": "kithoard",
  "version": "1.1.3",
  "description": "Kithoard 栖材坞 · 本地素材中转站",
  "private": true,
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "fetch:ffmpeg": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fetch-ffmpeg.ps1",
    "pack:dir": "electron-builder --dir",
    "build:win": "electron-builder --win nsis --publish never",
    "gate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify.ps1"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@eslint/js": "^9.39.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "38.8.6",
    "electron-builder": "^26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "^9.39.0",
    "globals": "17.14.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
